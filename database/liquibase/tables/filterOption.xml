<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
        http://www.liquibase.org/xml/ns/dbchangelog-ext
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">



    <changeSet id="1" author="Ivaylo Mitrev">
        <createTable tableName="FILTER_OPTION">
            <column name="ID" type="uuid">
                <constraints primaryKey="true"/>
            </column>
            <column name="NAME" type="varchar(128)"/>
            <column name="PARENT_FILTER_OPTION_ID" type="uuid" />
            <column name="IS_ACTIVE" type="bool" />
        </createTable>
    </changeSet>

    <changeSet id="2" author="Ivaylo Mitrev">
        <addForeignKeyConstraint
                baseColumnNames="PARENT_FILTER_OPTION_ID"
                baseTableName="FILTER_OPTION"
                referencedColumnNames="ID"
                referencedTableName="FILTER_OPTION"
                constraintName="PARENT_FILTER_FK"/>
    </changeSet>

</databaseChangeLog>