<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
        http://www.liquibase.org/xml/ns/dbchangelog-ext
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">



    <changeSet id="1" author="Ivaylo Mitrev">
        <createTable tableName="ORGANIZATION">
            <column name="ID" type="uuid">
                <constraints primaryKey="true"/>
            </column>
            <column name="NAME" type="varchar(256)"/>
            <column name="EIK" type="varchar(36)" />
            <column name="ADDRESS" type="VARCHAR(256)" />
            <column name="DESCRIPTION" type="varchar(2048)" />
            <column name="SECTOR" type="varchar(256)" />
            <column name="YEAR_CREATED" type="varchar(5)" />
            <column name="DATE_JOINED" type="timestamp" />
            <column name="IS_ACTIVE" type="bool" />
            <!-- TODO: Pictures  -->
            <!-- TODO: Subscription  -->
            <!-- TODO: Admin users for this organization  -->
            <!-- TODO: billing information  -->
        </createTable>

    </changeSet>

    <changeSet id="2" author="Ivaylo Mitrev">
        <comment>Add NOT NULL constraints, fix data types, and add defaults for ORGANIZATION</comment>

        <!-- Add NOT NULL constraint to NAME -->
        <addNotNullConstraint
            tableName="ORGANIZATION"
            columnName="NAME"
            columnDataType="varchar(256)"/>

        <!-- Change YEAR_CREATED from varchar(5) to SMALLINT -->
        <modifyDataType
            tableName="ORGANIZATION"
            columnName="YEAR_CREATED"
            newDataType="SMALLINT"/>

        <!-- Add default value for IS_ACTIVE -->
        <addDefaultValue
            tableName="ORGANIZATION"
            columnName="IS_ACTIVE"
            defaultValueBoolean="true"/>

        <!-- Add NOT NULL constraint to IS_ACTIVE -->
        <addNotNullConstraint
            tableName="ORGANIZATION"
            columnName="IS_ACTIVE"
            columnDataType="bool"/>
    </changeSet>

    <changeSet id="3" author="Ivaylo Mitrev">
        <comment>Add indexes for ORGANIZATION table</comment>

        <createIndex indexName="IDX_ORGANIZATION_NAME" tableName="ORGANIZATION">
            <column name="NAME"/>
        </createIndex>

        <createIndex indexName="IDX_ORGANIZATION_SECTOR" tableName="ORGANIZATION">
            <column name="SECTOR"/>
        </createIndex>

        <createIndex indexName="IDX_ORGANIZATION_IS_ACTIVE" tableName="ORGANIZATION">
            <column name="IS_ACTIVE"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>