<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
        http://www.liquibase.org/xml/ns/dbchangelog-ext
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">



    <changeSet id="1" author="Ivaylo Mitrev">
        <createTable tableName="FILTER_OPTION">
            <column name="ID" type="uuid">
                <constraints primaryKey="true"/>
            </column>
            <column name="NAME" type="varchar(128)"/>
            <column name="TYPE" type="varchar(128)"/>
            <column name="PRESENTABLE_NAME" type="varchar(256)"/>
            <column name="PARENT_FILTER_OPTION_ID" type="uuid" />
            <column name="IS_ACTIVE" type="bool" />
        </createTable>
    </changeSet>

    <changeSet id="2" author="Ivaylo Mitrev">
        <addForeignKeyConstraint
                baseColumnNames="PARENT_FILTER_OPTION_ID"
                baseTableName="FILTER_OPTION"
                referencedColumnNames="ID"
                referencedTableName="FILTER_OPTION"
                constraintName="PARENT_FILTER_FK"/>
    </changeSet>

    <changeSet id="3" author="Ivaylo Mitrev">
        <comment>Add NOT NULL constraints and defaults for FILTER_OPTION</comment>

        <!-- Add NOT NULL constraint to NAME -->
        <addNotNullConstraint
            tableName="FILTER_OPTION"
            columnName="NAME"
            columnDataType="varchar(128)"/>

        <!-- Add NOT NULL constraint to TYPE -->
        <addNotNullConstraint
            tableName="FILTER_OPTION"
            columnName="TYPE"
            columnDataType="varchar(128)"/>

        <!-- Add default value for IS_ACTIVE -->
        <addDefaultValue
            tableName="FILTER_OPTION"
            columnName="IS_ACTIVE"
            defaultValueBoolean="true"/>

        <!-- Add NOT NULL constraint to IS_ACTIVE -->
        <addNotNullConstraint
            tableName="FILTER_OPTION"
            columnName="IS_ACTIVE"
            columnDataType="bool"/>
    </changeSet>

    <changeSet id="4" author="Ivaylo Mitrev">
        <comment>Add indexes for FILTER_OPTION table</comment>

        <createIndex indexName="IDX_FILTER_OPTION_TYPE" tableName="FILTER_OPTION">
            <column name="TYPE"/>
        </createIndex>

        <createIndex indexName="IDX_FILTER_OPTION_PARENT" tableName="FILTER_OPTION">
            <column name="PARENT_FILTER_OPTION_ID"/>
        </createIndex>

        <createIndex indexName="IDX_FILTER_OPTION_IS_ACTIVE" tableName="FILTER_OPTION">
            <column name="IS_ACTIVE"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>